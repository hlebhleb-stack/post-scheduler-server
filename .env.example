PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/dbname

# Sentry DSN (получить на sentry.io после создания проекта)
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# Logtail Source Token (получить на betterstack.com/logs)
LOGTAIL_SOURCE_TOKEN=xxxx

# JWT
JWT_SECRET=your-secret-key
