{
  "info": {
    "name": "Post Scheduler API — ИПР1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "modToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123!\",\n  \"role\": \"admin\"\n}" }
          }
        },
        {
          "name": "Register moderator",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"mod@test.com\",\n  \"password\": \"Moder123!\",\n  \"role\": \"moderator\"\n}" }
          }
        },
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"User1234!\",\n  \"role\": \"user\"\n}" }
          }
        },
        {
          "name": "Register — слабый пароль (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"bad@test.com\",\n  \"password\": \"123\"\n}" }
          }
        },
        {
          "name": "Register — неверный email (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"notanemail\",\n  \"password\": \"Test123!\"\n}" }
          }
        },
        {
          "name": "Login admin",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.token) pm.collectionVariables.set('adminToken', r.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123!\"\n}" }
          }
        },
        {
          "name": "Login moderator",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.token) pm.collectionVariables.set('modToken', r.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"mod@test.com\",\n  \"password\": \"Moder123!\"\n}" }
          }
        },
        {
          "name": "Login user",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json(); if(r.token) pm.collectionVariables.set('userToken', r.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"User1234!\"\n}" }
          }
        },
        {
          "name": "Login — неверный пароль (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"WrongPass1!\"\n}" }
          }
        },
        {
          "name": "GET /auth/me — с токеном (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "GET /auth/me — без токена (401)",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET /posts — публичный (200)",
          "request": { "method": "GET", "url": "{{baseUrl}}/posts" }
        },
        {
          "name": "GET /posts?platform=telegram",
          "request": { "method": "GET", "url": "{{baseUrl}}/posts?platform=telegram" }
        },
        {
          "name": "GET /posts/:id — найден (200)",
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/1" }
        },
        {
          "name": "GET /posts/:id — не найден (404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/9999" }
        },
        {
          "name": "POST /posts — как user (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/posts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Новый пост\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-11-01T12:00:00Z\"\n}" }
          }
        },
        {
          "name": "POST /posts — без токена (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/posts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Пост\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-11-01T12:00:00Z\"\n}" }
          }
        },
        {
          "name": "POST /posts — невалидные данные (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/posts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"\",\n  \"platform\": \"tiktok\"\n}" }
          }
        },
        {
          "name": "PUT /posts/:id — как moderator (200)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/posts/2",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{modToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Обновлено модератором\",\n  \"status\": \"published\"\n}" }
          }
        },
        {
          "name": "PUT /posts/:id — как user (403)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/posts/2",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Попытка user\"\n}" }
          }
        },
        {
          "name": "DELETE /posts/:id — как admin (204)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/posts/2",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "DELETE /posts/:id — как user (403)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/posts/3",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }]
          }
        }
      ]
    }
  ]
}
