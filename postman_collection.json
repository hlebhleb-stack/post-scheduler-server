{
  "info": {
    "name": "Post Scheduler — КР1",
    "_postman_id": "kr1-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (user)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"pass123\"\n}" }
          }
        },
        {
          "name": "Register (admin)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\",\n  \"role\": \"admin\"\n}" }
          }
        },
        {
          "name": "Register — короткий пароль (400)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"weak@test.com\",\n  \"password\": \"abc\"\n}" }
          }
        },
        {
          "name": "Register — дубликат email (409)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"pass123\"\n}" }
          }
        },
        {
          "name": "Login (user) — сохраняет токен",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"pass123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var j = pm.response.json(); if (j.token) { pm.collectionVariables.set('token', j.token); }"] } }]
        },
        {
          "name": "Login (admin) — сохраняет adminToken",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var j = pm.response.json(); if (j.token) { pm.collectionVariables.set('adminToken', j.token); }"] } }]
        },
        {
          "name": "Login — неверный пароль (401)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"wrongpass\"\n}" }
          }
        },
        {
          "name": "Me — с токеном (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Me — без токена (401)",
          "request": {
            "method": "GET",
            "url": "{{base}}/auth/me",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET /posts — все (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/posts"
          }
        },
        {
          "name": "GET /posts?platform=telegram — фильтрация (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/posts?platform=telegram"
          }
        },
        {
          "name": "GET /posts/:id (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/posts/1"
          }
        },
        {
          "name": "GET /posts/:id — не найден (404)",
          "request": {
            "method": "GET",
            "url": "{{base}}/posts/9999"
          }
        },
        {
          "name": "POST /posts — с токеном (201)",
          "request": {
            "method": "POST",
            "url": "{{base}}/posts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Тестовый пост\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-12-01T12:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "POST /posts — без токена (401)",
          "request": {
            "method": "POST",
            "url": "{{base}}/posts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Без токена\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-12-01T12:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "POST /posts — невалидные данные (400)",
          "request": {
            "method": "POST",
            "url": "{{base}}/posts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"\",\n  \"platform\": \"tiktok\"\n}" }
          }
        },
        {
          "name": "PUT /posts/1 — автор (200)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/posts/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Обновлённый текст\",\n  \"status\": \"published\"\n}" }
          }
        },
        {
          "name": "PUT /posts/1 — не автор (403)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/posts/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Админ правит чужой пост\"\n}" }
          }
        },
        {
          "name": "DELETE /posts/1 — user (403)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/posts/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "DELETE /posts/1 — admin (204)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/posts/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }
  ]
}
