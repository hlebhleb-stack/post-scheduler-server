{
  "info": {
    "name": "Post Scheduler — ИПР1",
    "_postman_id": "ipr1-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "modToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (user)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"Password1!\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('token', ''); }"] } }]
        },
        {
          "name": "Register (admin)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123!\",\n  \"role\": \"admin\"\n}" }
          }
        },
        {
          "name": "Register (moderator)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"mod@test.com\",\n  \"password\": \"Moder123!\",\n  \"role\": \"moderator\"\n}" }
          }
        },
        {
          "name": "Register — слабый пароль (400)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"weak@test.com\",\n  \"password\": \"abc\"\n}" }
          }
        },
        {
          "name": "Login (user) — сохраняет токен",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"Password1!\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var j = pm.response.json(); if (j.token) { pm.collectionVariables.set('token', j.token); }"] } }]
        },
        {
          "name": "Login (admin) — сохраняет adminToken",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Admin123!\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var j = pm.response.json(); if (j.token) { pm.collectionVariables.set('adminToken', j.token); }"] } }]
        },
        {
          "name": "Login — неверный пароль (401)",
          "request": {
            "method": "POST",
            "url": "{{base}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"WrongPass1!\"\n}" }
          }
        },
        {
          "name": "Me — с токеном (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Me — без токена (401)",
          "request": {
            "method": "GET",
            "url": "{{base}}/auth/me",
            "header": []
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "GET /posts — публичный (200)",
          "request": {
            "method": "GET",
            "url": "{{base}}/posts"
          }
        },
        {
          "name": "POST /posts — с токеном (201)",
          "request": {
            "method": "POST",
            "url": "{{base}}/posts",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Тестовый пост\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-12-01T12:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "POST /posts — без токена (401)",
          "request": {
            "method": "POST",
            "url": "{{base}}/posts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Без токена\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-12-01T12:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "PUT /posts/1 — moderator (200)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/posts/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{modToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Обновлённый контент\",\n  \"platform\": \"telegram\",\n  \"scheduledAt\": \"2026-12-01T12:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "DELETE /posts/1 — user → 403",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/posts/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "DELETE /posts/1 — admin (204)",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/posts/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }
  ]
}
